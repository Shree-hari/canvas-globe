{
  "name": "react-canvas-globe",
  "version": "0.1.0",
  "description": "React component for interactive 3D globes and world maps rendered with Canvas 2D, powered by canvas-globe.",
  "license": "GPL-3.0-only",
  "author": {
    "name": "Harsh Jhunjhunuwala"
  },
