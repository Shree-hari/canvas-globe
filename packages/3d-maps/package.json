{
  "name": "3d-maps",
  "version": "1.4.1",
  "description": "Create interactive 3D maps, globe visualizations, and flat world maps in JavaScript with Canvas 2D and no WebGL.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Harsh Jhunjhunuwala"
  },
  "homepage": "https://canvasglobe.swiftools.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shree-hari/canvas-globe.git",
    "directory": "packages/3d-maps"
  },
  "bugs": {
    "url": "https://github.com/Shree-hari/canvas-globe/issues"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./element": {
      "types": "./element.d.ts",
      "import": "./element.js",
      "default": "./element.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js",
      "default": "./react.js"
    },
    "./fx": {
      "types": "./fx.d.ts",
      "import": "./fx.js",
      "default": "./fx.js"
    },
    "./fx/interaction": {
      "types": "./fx-interaction.d.ts",
      "import": "./fx-interaction.js",
      "default": "./fx-interaction.js"
    },
    "./recipes": {
      "types": "./recipes.d.ts",
      "import": "./recipes.js",
      "default": "./recipes.js"
    },
    "./charts": {
      "types": "./charts.d.ts",
      "import": "./charts.js",
      "default": "./charts.js"
    },
    "./controls": {
      "types": "./controls.d.ts",
      "import": "./controls.js",
      "default": "./controls.js"
    },
    "./places": {
      "types": "./places.d.ts",
      "import": "./places.js",
      "default": "./places.js"
    },
    "./data/world": {
      "types": "./data/world.d.ts",
      "import": "./data/world.js",
      "default": "./data/world.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "element.js",
    "element.d.ts",
    "react.js",
    "react.d.ts",
    "fx.js",
    "fx.d.ts",
    "fx-interaction.js",
    "fx-interaction.d.ts",
    "recipes.js",
    "recipes.d.ts",
    "charts.js",
    "charts.d.ts",
    "controls.js",
    "controls.d.ts",
    "places.js",
    "places.d.ts",
    "data",
    "README.md",
    "LICENSE.md",
    "LICENSING.md"
  ],
  "sideEffects": [
    "./element.js"
  ],
  "dependencies": {
    "canvas-globe": "^1.4.1"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "3d-maps",
    "3d-map",
    "interactive-3d-map",
    "javascript-3d-map",
    "web-3d-map",
    "3d-map-javascript",
    "3d-map-library",
    "3d-globe-map",
    "3d-globe",
    "globe-map",
    "interactive-globe",
    "javascript-globe",
    "world-map",
    "canvas-globe",
    "no-webgl",
    "geospatial-visualization"
  ],
  "private": false
}

