{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "canvas-globe": ["./types/index.d.ts"],
      "canvas-globe/fx": ["./types/fx.d.ts"],
      "canvas-globe/fx/interaction": ["./types/fx-interaction.d.ts"],
      "canvas-globe/charts": ["./types/charts.d.ts"],
      "canvas-globe/recipes": ["./types/recipes.d.ts"],
      "canvas-globe/controls": ["./types/controls.d.ts"],
      "canvas-globe/places": ["./types/places.d.ts"],
      "3d-globe-map": ["./packages/3d-globe-map/index.d.ts"],
      "canvas-globe-svelte": ["./packages/canvas-globe-svelte/index.d.ts"],
      "canvas-globe-vue": ["./packages/canvas-globe-vue/index.d.ts"],
      "canvas-globe-web-component": ["./packages/canvas-globe-web-component/index.d.ts"],
      "react-canvas-globe": ["./packages/react-canvas-globe/index.d.ts"]
    }
  },
  "include": [
    "registry/**/*.tsx",
    "packages/3d-globe-map/**/*.d.ts",
    "packages/canvas-globe-svelte/**/*.d.ts",
    "packages/canvas-globe-vue/**/*.d.ts",
    "packages/canvas-globe-web-component/**/*.d.ts",
    "packages/react-canvas-globe/**/*.d.ts",
    "test/ecosystem-types.tsx"
  ]
}
