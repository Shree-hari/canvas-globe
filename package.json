{
  "name": "canvas-globe",
  "version": "0.1.0",
  "description": "Zero-dependency JavaScript and React library for interactive 3D globes and flat world maps rendered with Canvas 2D. No WebGL or API key.",
  "license": "GPL-3.0-only",
  "author": {
    "name": "Harsh Jhunjhunuwala"
  },
  "homepage": "https://shree-hari.github.io/canvas-globe/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shree-hari/canvas-globe.git"
  },
  "bugs": {
    "url": "https://github.com/Shree-hari/canvas-globe/issues"
  },
  "keywords": [
    "javascript-globe",
    "interactive-globe",
    "canvas-globe",
    "globe",
    "canvas",
    "interactive",
    "map",
    "world-map",
    "react-globe",
    "react",
    "globe-visualization",
    "data-visualization",
    "canvas-2d",
    "no-webgl",
    "zero-dependency",
    "choropleth-map",
    "orthographic-projection",
    "geospatial",
    "markers",
    "great-circle-arcs",
    "web-component",
    "vanilla-javascript"
  ],
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/canvas-globe.umd.js",
  "jsdelivr": "./dist/canvas-globe.umd.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "import": "./src/element.js",
      "default": "./src/element.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./src/react.js",
      "default": "./src/react.js"
    },
    "./data/world": "./src/data/world.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "CHANGELOG.md",
    "COPYRIGHT",
    "LICENSE",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "codemeta.json"
  ],
  "sideEffects": [
    "./src/element.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "data": "node scripts/generate-data.mjs && node scripts/generate-timezones.mjs",
    "example": "node scripts/serve.mjs",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:package": "node scripts/package-smoke.mjs",
    "docs": "npm --prefix website run start",
    "docs:build": "npm --prefix website run build",
    "docs:serve": "npm --prefix website run serve",
    "release:check": "npm run test && npm run typecheck && npm run build && npm run docs:build && node scripts/release-check.mjs && npm run smoke:package",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build && node scripts/release-check.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "polygon-clipping": "^0.15.7",
    "topojson-client": "^3.1.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
