{
  "name": "@swiftools/geo-globe",
  "version": "0.1.0",
  "description": "Zero-dependency interactive globe and world map on a 2D canvas. Drag to spin, animated markers, avatars, themes — no WebGL, no API keys, no network calls.",
  "license": "MIT",
  "keywords": [
    "globe",
    "world-map",
    "canvas",
    "visualization",
    "geo",
    "analytics",
    "markers",
    "orthographic",
    "interactive",
    "no-dependencies",
    "choropleth",
    "great-circle",
    "arcs",
    "react",
    "web-component"
  ],
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/geo-globe.umd.js",
  "jsdelivr": "./dist/geo-globe.umd.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "import": "./src/element.js",
      "default": "./src/element.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./src/react.js",
      "default": "./src/react.js"
    },
    "./data/world": "./src/data/world.js",
    "./data/india": "./src/data/india.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "data": "node scripts/generate-data.mjs && node scripts/generate-timezones.mjs",
    "example": "node scripts/serve.mjs",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs": "npm --prefix website run start",
    "docs:build": "npm --prefix website run build",
    "docs:serve": "npm --prefix website run serve",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "topojson-client": "^3.1.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
