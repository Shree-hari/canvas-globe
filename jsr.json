{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@swiftools/canvas-globe",
  "version": "1.4.1",
  "exports": {
    ".": "./src/index.js",
    "./element": "./jsr/element.js",
    "./fx": "./src/fx/index.js",
    "./fx/interaction": "./src/fx/effects/interaction.js",
    "./recipes": "./src/recipes.js",
    "./charts": "./src/charts.js",
    "./controls": "./src/controls.js",
    "./places": "./src/places.js",
    "./data/world": "./jsr/data/world.js"
  },
  "publish": {
    "include": [
      "src",
      "jsr",
      "types/index.d.ts",
      "types/jsr-element.d.ts",
      "types/fx.d.ts",
      "types/fx-interaction.d.ts",
      "types/recipes.d.ts",
      "types/charts.d.ts",
      "types/controls.d.ts",
      "types/places.d.ts",
      "types/data/world.d.ts",
      "README.md",
      "CHANGELOG.md",
      "COPYRIGHT",
      "LICENSE.md",
      "LICENSING.md",
      "THIRD_PARTY_NOTICES.md",
      "custom-elements.json",
      "package.json"
    ],
    "exclude": [
      "src/react.js",
      "types/react.d.ts"
    ]
  }
}
